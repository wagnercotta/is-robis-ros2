FROM ros:humble

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-c"]

# Pacotes básicos de runtime e build ROS 2.
# Esta imagem é para simulação: não instala ODrive físico nem YDLidar físico.
RUN apt-get update && apt-get install -y --no-install-recommends \
    net-tools \
    vim \
    python3-pip \
    python3-colcon-common-extensions \
    ros-humble-diagnostic-updater \
    ros-humble-example-interfaces \
    ros-humble-tf-transformations \
    ros-humble-nav2-msgs \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-std-msgs \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-tf2-ros \
    && rm -rf /var/lib/apt/lists/*

# Ambiente ROS 2/DDS.
# Use --network=host ao executar o container para enxergar o Gazebo/Nav2 em outra máquina.
ENV ROS_DOMAIN_ID=0
ENV ROS_LOCALHOST_ONLY=0
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

WORKDIR /workspace/ros2_ws

RUN mkdir -p src

# Mantém o pacote do robô porque ele contém seus nodes/controladores de alto nível.
# Na simulação, NÃO use launches que iniciem odrive_launch.py ou ydlidar_launch.py.
COPY odrive_ros2_pkg/ src/odrive_ros2_pkg/

# Build somente do pacote que contém a lógica do robô.
RUN source /opt/ros/humble/setup.bash \
    && colcon build --packages-select odrive_ros2_pkg

# Entrypoint ROS 2.
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -e' \
'' \
'source /opt/ros/humble/setup.bash' \
'' \
'if [ -f /workspace/ros2_ws/install/setup.bash ]; then' \
'    source /workspace/ros2_ws/install/setup.bash' \
'fi' \
'' \
'exec "$@"' \
> /ros_entrypoint.sh \
&& chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]

# Launch simulado: deve iniciar apenas os nodes lógicos/controladores.
# Não deve iniciar ODrive nem YDLidar.
CMD ["ros2", "launch", "odrive_ros2_pkg", "is_robis_sim_launch.py", "namespace:=robis"]

WORKDIR /workspace/ros2_ws
